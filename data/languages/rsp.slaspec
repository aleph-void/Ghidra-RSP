# Nintendo 64 RSP (Reality Signal Processor): scalar unit, COP0 and the glue for the vector unit.
#
# The RSP is a MIPS-like core (32 GPRs, big endian, delay slots) with a subset of MIPS I:
# no multiply/divide, no HI/LO, no traps, no unaligned loads (LWL/LWR), no FPU, no exceptions;
# ADD/ADDI/SUB never trap (they are ADDU/ADDIU/SUBU), LWU is LW. COP0 reaches the SP/DPC
# registers, COP2 is the 8-lane x 16-bit vector unit (rsp_vector.sinc, generated by
# gen/gen_rsp_vector.py).
#
# Address model (the same one the loader uses): DMEM is 0x0000-0x0FFF, IMEM is 0x1000-0x1FFF of one
# 32-bit space. Data accesses always go to DMEM and wrap at 4 KB; the PC is 12 bits wide, so
# branch/jump targets and JR/JALR targets are folded into IMEM (0x1000 | (target & 0xFFF)) and
# the link value written to RA by JAL/JALR/BLTZAL/BGEZAL is the 12-bit PC (as on hardware).

define endian=big;
define alignment=4;

define space ram      type=ram_space      size=4 default;
define space register type=register_space size=4;

define register offset=0x0000 size=4 [
	zero r1  r2  r3  r4  r5  r6  r7
	r8   r9  r10 r11 r12 r13 r14 r15
	r16  r17 r18 r19 r20 r21 r22 r23
	r24  r25 r26 r27 r28 sp  r30 ra
];

define register offset=0x0100 size=4 [ pc ];

# COP0 registers 0-15: the SP interface (0-7) and the RDP command interface (8-15)
define register offset=0x0200 size=4 [
	SP_MEM_ADDR SP_DRAM_ADDR SP_RD_LEN SP_WR_LEN SP_STATUS SP_DMA_FULL SP_DMA_BUSY SP_SEMAPHORE
	DPC_START DPC_END DPC_CURRENT DPC_STATUS DPC_CLOCK DPC_BUFBUSY DPC_PIPEBUSY DPC_TMEM
];

# Vector unit state
define register offset=0x1000 size=16 [
	v0  v1  v2  v3  v4  v5  v6  v7  v8  v9  v10 v11 v12 v13 v14 v15
	v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31
];
# The three 16-bit slices of the eight 48-bit accumulators
define register offset=0x1400 size=16 [ ACC_H ACC_M ACC_L ];
# VCO/VCC: bit n is lane n of the low flag byte, bit 8+n lane n of the high one (as read by CFC2)
define register offset=0x1440 size=2 [ VCO VCC ];
define register offset=0x1450 size=1 [ VCE ];
# Reciprocal unit: input latch, output latch, double-precision flag
define register offset=0x1460 size=2 [ DIVIN DIVOUT ];
define register offset=0x1470 size=1 [ DIVDP ];

define token instr(32)
	op      = (26,31)
	rs_f    = (21,25)
	rt_f    = (16,20)
	rd_f    = (11,15)
	sa      = (6,10)
	fn      = (0,5)
	imm16   = (0,15)
	simm16  = (0,15) signed
	target  = (0,25)
	bit25   = (25,25)
	cop0rd  = (11,14)
	vt_f    = (16,20)
	vs_f    = (11,15)
	vd_f    = (6,10)
	vsel    = (21,24)
	lsop    = (11,15)
	lsel    = (7,10) dec
	loff    = (0,6) signed
	vtgrp   = (19,20)
	c2rd    = (11,15)
	lneg    = (6,6)
	cr2     = (11,12)
	dsel    = (11,13) dec
	esel    = (21,23) dec
	vsb0    = (11,11)
	lsel_h  = (8,10)
;

attach variables [ rs_f rt_f rd_f ] [
	zero r1  r2  r3  r4  r5  r6  r7
	r8   r9  r10 r11 r12 r13 r14 r15
	r16  r17 r18 r19 r20 r21 r22 r23
	r24  r25 r26 r27 r28 sp  r30 ra
];

attach variables [ vt_f vs_f vd_f ] [
	v0  v1  v2  v3  v4  v5  v6  v7  v8  v9  v10 v11 v12 v13 v14 v15
	v16 v17 v18 v19 v20 v21 v22 v23 v24 v25 v26 v27 v28 v29 v30 v31
];

attach variables [ cop0rd ] [
	SP_MEM_ADDR SP_DRAM_ADDR SP_RD_LEN SP_WR_LEN SP_STATUS SP_DMA_FULL SP_DMA_BUSY SP_SEMAPHORE
	DPC_START DPC_END DPC_CURRENT DPC_STATUS DPC_CLOCK DPC_BUFBUSY DPC_PIPEBUSY DPC_TMEM
];

define pcodeop rsp_break;

# ---- operands ---------------------------------------------------------------------------------
# Sources: r0 reads as the constant 0. Destinations: a write to r0 goes to a throw-away temporary.

rs: rs_f is rs_f { export rs_f; }
rs: "zero" is rs_f=0 { local z:4 = 0; export z; }
rt: rt_f is rt_f { export rt_f; }
rt: "zero" is rt_f=0 { local z:4 = 0; export z; }

wrd: rd_f is rd_f { export rd_f; }
wrd: "zero" is rd_f=0 { local t:4; export t; }
wrt: rt_f is rt_f { export rt_f; }
wrt: "zero" is rt_f=0 { local t:4; export t; }

# Branch and jump targets, folded into IMEM
reloc: addr is simm16 [ addr = (((inst_next + (simm16 << 2)) & 0xFFF) | 0x1000); ] { export *[ram]:4 addr; }
jtarget: addr is target [ addr = (((target << 2) & 0xFFF) | 0x1000); ] { export *[ram]:4 addr; }

# Data address: base register + displacement, wrapped into DMEM
ea: simm16(rs) is simm16 & rs { local a:4 = (rs + simm16) & 0xFFF; export a; }

# inst_next in p-code is the address after the delay slot, i.e. the return address
@define LINK "inst_next & 0xFFF"

# ---- scalar ALU -------------------------------------------------------------------------------

:nop is op=0 & rs_f=0 & rt_f=0 & rd_f=0 & sa=0 & fn=0 { }

:sll wrd, rt, sa is op=0 & fn=0 & wrd & rt & sa { wrd = rt << sa; }
:srl wrd, rt, sa is op=0 & fn=2 & wrd & rt & sa { wrd = rt >> sa; }
:sra wrd, rt, sa is op=0 & fn=3 & wrd & rt & sa { wrd = rt s>> sa; }
:sllv wrd, rt, rs is op=0 & fn=4 & wrd & rt & rs { wrd = rt << (rs & 0x1f); }
:srlv wrd, rt, rs is op=0 & fn=6 & wrd & rt & rs { wrd = rt >> (rs & 0x1f); }
:srav wrd, rt, rs is op=0 & fn=7 & wrd & rt & rs { wrd = rt s>> (rs & 0x1f); }

:add wrd, rs, rt is op=0 & fn=32 & wrd & rs & rt { wrd = rs + rt; }
:addu wrd, rs, rt is op=0 & fn=33 & wrd & rs & rt { wrd = rs + rt; }
:sub wrd, rs, rt is op=0 & fn=34 & wrd & rs & rt { wrd = rs - rt; }
:subu wrd, rs, rt is op=0 & fn=35 & wrd & rs & rt { wrd = rs - rt; }
:and wrd, rs, rt is op=0 & fn=36 & wrd & rs & rt { wrd = rs & rt; }
:or wrd, rs, rt is op=0 & fn=37 & wrd & rs & rt { wrd = rs | rt; }
:xor wrd, rs, rt is op=0 & fn=38 & wrd & rs & rt { wrd = rs ^ rt; }
:nor wrd, rs, rt is op=0 & fn=39 & wrd & rs & rt { wrd = ~(rs | rt); }
:slt wrd, rs, rt is op=0 & fn=42 & wrd & rs & rt { wrd = zext(rs s< rt); }
:sltu wrd, rs, rt is op=0 & fn=43 & wrd & rs & rt { wrd = zext(rs < rt); }

:addi wrt, rs, simm16 is op=8 & wrt & rs & simm16 { wrt = rs + simm16; }
:addiu wrt, rs, simm16 is op=9 & wrt & rs & simm16 { wrt = rs + simm16; }
:slti wrt, rs, simm16 is op=10 & wrt & rs & simm16 { wrt = zext(rs s< simm16); }
:sltiu wrt, rs, simm16 is op=11 & wrt & rs & simm16 { wrt = zext(rs < simm16); }
:andi wrt, rs, imm16 is op=12 & wrt & rs & imm16 { wrt = rs & imm16; }
:ori wrt, rs, imm16 is op=13 & wrt & rs & imm16 { wrt = rs | imm16; }
:xori wrt, rs, imm16 is op=14 & wrt & rs & imm16 { wrt = rs ^ imm16; }
:lui wrt, imm16 is op=15 & wrt & imm16 { wrt = imm16 << 16; }

# ---- loads and stores (DMEM only, address wraps at 4 KB) -------------------------------------

:lb wrt, ea is op=32 & wrt & ea { wrt = sext(*[ram]:1 ea); }
:lh wrt, ea is op=33 & wrt & ea { wrt = sext(*[ram]:2 ea); }
:lw wrt, ea is op=35 & wrt & ea { wrt = *[ram]:4 ea; }
:lbu wrt, ea is op=36 & wrt & ea { wrt = zext(*[ram]:1 ea); }
:lhu wrt, ea is op=37 & wrt & ea { wrt = zext(*[ram]:2 ea); }
:lwu wrt, ea is op=39 & wrt & ea { wrt = *[ram]:4 ea; }
:sb rt, ea is op=40 & rt & ea { local t:4 = rt; *[ram]:1 ea = t:1; }
:sh rt, ea is op=41 & rt & ea { local t:4 = rt; *[ram]:2 ea = t:2; }
:sw rt, ea is op=43 & rt & ea { *[ram]:4 ea = rt; }

# ---- branches (all have a delay slot) --------------------------------------------------------

:beq rs, rt, reloc is op=4 & rs & rt & reloc { local c = rs == rt; delayslot(1); if (c) goto reloc; }
:bne rs, rt, reloc is op=5 & rs & rt & reloc { local c = rs != rt; delayslot(1); if (c) goto reloc; }
:blez rs, reloc is op=6 & rs & reloc { local c = rs s<= 0; delayslot(1); if (c) goto reloc; }
:bgtz rs, reloc is op=7 & rs & reloc { local c = rs s> 0; delayslot(1); if (c) goto reloc; }
:bltz rs, reloc is op=1 & rt_f=0 & rs & reloc { local c = rs s< 0; delayslot(1); if (c) goto reloc; }
:bgez rs, reloc is op=1 & rt_f=1 & rs & reloc { local c = rs s>= 0; delayslot(1); if (c) goto reloc; }
:bltzal rs, reloc is op=1 & rt_f=16 & rs & reloc {
	local c = rs s< 0;
	ra = $(LINK);
	delayslot(1);
	if (!c) goto inst_next;
	call reloc;
}
:bgezal rs, reloc is op=1 & rt_f=17 & rs & reloc {
	local c = rs s>= 0;
	ra = $(LINK);
	delayslot(1);
	if (!c) goto inst_next;
	call reloc;
}

:j jtarget is op=2 & jtarget { delayslot(1); goto jtarget; }
:jal jtarget is op=3 & jtarget { ra = $(LINK); delayslot(1); call jtarget; }

:jr "ra" is op=0 & fn=8 & rs_f=31 { local d:4 = (ra & 0xFFC) | 0x1000; delayslot(1); return [d]; }
:jr rs is op=0 & fn=8 & rs { local d:4 = (rs & 0xFFC) | 0x1000; delayslot(1); goto [d]; }
:jalr rs is op=0 & fn=9 & rd_f=31 & rs { local d:4 = (rs & 0xFFC) | 0x1000; ra = $(LINK); delayslot(1); call [d]; }
:jalr rs, wrd is op=0 & fn=9 & wrd & rs { local d:4 = (rs & 0xFFC) | 0x1000; wrd = $(LINK); delayslot(1); call [d]; }

:break is op=0 & fn=13 { rsp_break(); }

# ---- COP0 ------------------------------------------------------------------------------------

:mfc0 wrt, cop0rd is op=16 & rs_f=0 & wrt & cop0rd { wrt = cop0rd; }
:mtc0 rt, cop0rd is op=16 & rs_f=4 & rt & cop0rd { cop0rd = rt; }

@include "rsp_vector.sinc"
