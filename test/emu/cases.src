endasm
set v1 0x00000000000000000003000000000000
expect v4 0x0000a000000000000000000000000000
expect DIVOUT 0x2aaa
expect ACC_L 0x00030003000300030003000300030003
end

case vrcp_negative_and_zero
asm
  vrcp v7[7],v1[3]
  vrcp v8[2],v1[0]
endasm
set v1 0x000000000000ffff0000000000000000
expect v7 0x00000000000000000000000000003fff
expect v8 0x00000000ffff00000000000000000000
expect DIVOUT 0x7fff
end

case vmov_and_vsar
asm
  vsar v4,v5,v6[0]
  vsar v7,v5,v6[1]
  vsar v8,v5,v6[2]
