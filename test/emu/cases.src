# RSP emulation cases.  Every expectation was worked out by hand from the instruction semantics (MIPS I
# subset + RSP vector unit as documented on n64brew and implemented by hardware-tested emulators), not
# from this module's output.  build_cases.py assembles the "asm" blocks with armips into "code" lines.
# Data memory is DMEM (0x0000-0x0fff); code runs at 0x1000.  Vector registers are written as 32 hex
# digits, lane 0 first.

case addiu_negative
asm
  addiu r1,zero,-1
  addiu r2,r1,3
endasm
expect r1 0xffffffff
expect r2 2
end

case add_addi_sub_never_trap
asm
  lui r1,0x7fff
  ori r1,r1,0xffff
  addi r2,r1,1
  add r3,r1,r1
  sub r4,zero,r1
endasm
expect r1 0x7fffffff
expect r2 0x80000000
expect r3 0xfffffffe
expect r4 0x80000001
end

case sub_subu
asm
  sub r3,r1,r2
  subu r4,r2,r1
endasm
set r1 5
set r2 7
expect r3 0xfffffffe
expect r4 2
end

case logic
asm
  and r3,r1,r2
  or r4,r1,r2
  xor r5,r1,r2
  nor r6,r1,r2
endasm
set r1 0xf0f0
set r2 0x0ff0
expect r3 0x00f0
expect r4 0xfff0
expect r5 0xff00
expect r6 0xffff000f
end

case compare_signed_unsigned
asm
  slt r3,r1,r2
  sltu r4,r1,r2
  slti r5,r1,0
  sltiu r6,r2,2
  sltiu r7,r1,-1
  slti r8,r2,-1
endasm
set r1 0xffffffff
set r2 1
expect r3 1
expect r4 0
expect r5 1
expect r6 1
expect r7 0
expect r8 0
end

case shifts
asm
  sll r2,r1,4
  srl r3,r1,4
  sra r4,r1,4
  sllv r6,r1,r5
  srlv r7,r1,r5
  srav r8,r1,r5
  sra r9,r1,31
  srl r10,r1,31
  sll r11,r1,31
endasm
set r1 0x80000001
set r5 36
expect r2 0x00000010
expect r3 0x08000000
expect r4 0xf8000000
expect r6 0x00000010
expect r7 0x08000000
expect r8 0xf8000000
expect r9 0xffffffff
expect r10 1
expect r11 0x80000000
end

case immediates
asm
  lui r1,0x1234
  ori r1,r1,0x5678
  andi r2,r1,0xff00
  xori r3,r1,0xffff
  ori r4,zero,0x8000
  addiu r5,zero,-0x8000
endasm
expect r1 0x12345678
expect r2 0x5600
expect r3 0x1234a987
expect r4 0x8000
expect r5 0xffff8000
end

case zero_register_is_constant
asm
  addiu zero,zero,5
  addu r1,zero,zero
  ori r2,zero,7
  lui zero,0x1234
  or r3,zero,r2
  lw zero,0x40(zero)
  addu r4,zero,zero
endasm
set mem:40 deadbeef
expect zero 0
expect r1 0
expect r2 7
expect r3 7
expect r4 0
end

case loads_extend
asm
  lb r1,0x100(zero)
  lbu r2,0x100(zero)
  lh r3,0x100(zero)
  lhu r4,0x100(zero)
  lw r5,0x100(zero)
  .word 0x9c060100 ; lwu r6,0x100(zero)
  lb r7,0x103(zero)
  lhu r8,0x102(zero)
endasm
set mem:100 80818283
expect r1 0xffffff80
expect r2 0x80
expect r3 0xffff8081
expect r4 0x8081
expect r5 0x80818283
expect r6 0x80818283
expect r7 0xffffff83
expect r8 0x8283
end

case stores_and_unaligned
asm
  sw r1,0x200(zero)
  sh r1,0x210(zero)
  sb r1,0x220(zero)
  sw r1,0x233(zero)
endasm
set r1 0x11223344
expect mem:200 11223344
expect mem:210 3344
expect mem:212 00
expect mem:220 44
expect mem:221 00
expect mem:233 11223344
expect mem:232 00
end

case dmem_address_wraps_at_4k
asm
  lw r2,0(r1)
  lw r4,0x110(r3)
  sw r2,0(r5)
endasm
set mem:100 12345678
set r1 0x1100
set r3 0xfff0
set r5 0x1300
expect r2 0x12345678
expect r4 0x12345678
expect mem:300 12345678
end

case beq_taken_runs_delay_slot
asm
  beq r1,r2,tgt
  addiu r3,zero,1
  addiu r4,zero,2
tgt:
  addiu r5,zero,3
endasm
set r1 7
set r2 7
expect r3 1
expect r4 0
expect r5 3
end

case beq_not_taken
asm
  beq r1,r2,tgt
  addiu r3,zero,1
  addiu r4,zero,2
tgt:
  addiu r5,zero,3
endasm
set r1 7
set r2 8
expect r3 1
expect r4 2
expect r5 3
end

case bne_taken
asm
  bne r1,r2,tgt
  nop
  addiu r4,zero,2
tgt:
  addiu r5,zero,3
endasm
set r1 7
set r2 8
expect r4 0
expect r5 3
end

case branches_on_negative
asm
  bltz r1,a
  nop
  ori r10,zero,1
a:
  bgez r1,b
  nop
  ori r11,zero,1
b:
  blez r1,c
  nop
  ori r12,zero,1
c:
  bgtz r1,d
  nop
  ori r13,zero,1
d:
endasm
set r1 0xfffffffb
expect r10 0
expect r11 1
expect r12 0
expect r13 1
end

case branches_on_zero
asm
  bltz r1,a
  nop
  ori r10,zero,1
a:
  bgez r1,b
  nop
  ori r11,zero,1
b:
  blez r1,c
  nop
  ori r12,zero,1
c:
  bgtz r1,d
  nop
  ori r13,zero,1
d:
endasm
set r1 0
expect r10 1
expect r11 0
expect r12 0
expect r13 1
end

case jal_jr_link_is_12_bit_pc
asm
  jal sub
  nop
  ori r6,zero,6
  j done
  nop
sub:
  ori r5,zero,5
  jr ra
  nop
done:
endasm
expect ra 8
expect r5 5
expect r6 6
end

case jalr_links_and_returns
asm
  addiu r2,zero,0x101c
  jalr r2
  nop
  ori r6,zero,6
  j done
  nop
  nop
  ori r5,zero,5
  jr ra
  nop
done:
endasm
expect ra 0xc
expect r5 5
expect r6 6
end

case jalr_other_link_register
asm
  addiu r2,zero,0x1010
  jalr r2,r7
  nop
  nop
  ori r5,zero,5
endasm
set ra 0x555
expect r7 0xc
expect ra 0x555
expect r5 5
end

case bltzal_bgezal_link_even_when_not_taken
asm
  bgezal r1,x
  nop
  ori r10,zero,1
x:
endasm
set r1 0xffffffff
expect ra 8
expect r10 1
end

case bltzal_taken
asm
  bltzal r1,x
  nop
  ori r10,zero,1
x:
endasm
set r1 0xffffffff
expect ra 8
expect r10 0
end

case jr_target_folds_into_imem
asm
  jr r2
  nop
  ori r4,zero,4
  ori r6,zero,6
  ori r5,zero,5
endasm
set r2 0x2010
expect r4 0
expect r6 0
expect r5 5
end

case cop0_moves
asm
  mtc0 r1,sp_mem_addr
  mfc0 r2,sp_mem_addr
  mtc0 r1,dpc_start
  mfc0 r3,dpc_start
endasm
set r1 0x1234
expect r2 0x1234
expect SP_MEM_ADDR 0x1234
expect DPC_START 0x1234
expect r3 0x1234
end

case mfc2_mtc2_byte_elements
asm
  mfc2 r1,v1[2]
  mfc2 r2,v1[14]
  mfc2 r3,v1[15]
  mfc2 r4,v2[0]
  mtc2 r5,v3[4]
  mtc2 r5,v4[15]
endasm
set v1 0x0102030405060708090a0b0c0d0e0f10
set v2 0x80018002000000000000000000000000
set r5 0xabcd
expect r1 0x304
expect r2 0xf10
expect r3 0x1001
expect r4 0xffff8001
expect v3 0x00000000abcd00000000000000000000
expect v4 0x000000000000000000000000000000ab
end

case cfc2_ctc2_flag_registers
asm
  ctc2 r1,vco
  cfc2 r2,vco
  ctc2 r1,vcc
  cfc2 r3,vcc
  ctc2 r1,vce
  cfc2 r4,vce
endasm
set r1 0xff01
expect VCO 0xff01
expect r2 0xffffff01
expect VCC 0xff01
expect r3 0xffffff01
expect VCE 0x01
expect r4 1
end

case vadd_saturates_and_keeps_low_bits
asm
  vadd v3,v1,v2
endasm
set v1 0x7fff80000005ffff000100001234fffe
set v2 0x0001ffff000700010001000000010003
expect v3 0x7fff8000000c00000002000012350001
expect ACC_L 0x80007fff000c00000002000012350001
expect VCO 0
end

