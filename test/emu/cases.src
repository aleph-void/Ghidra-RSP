case broadcast_quarter_and_half_and_scalar
asm
  vadd v3,v1,v2[0q]
  vadd v4,v1,v2[1h]
  vadd v5,v1,v2[3]
  vadd v6,v1,v2[0h]
  vadd v7,v1,v2[1q]
endasm
set v1 0x00010002000300040005000600070008
set v2 0x00100020003000400050006000700080
expect v3 0x00110012003300340055005600770078
expect v4 0x00210022002300240065006600670068
expect v5 0x00410042004300440045004600470048
expect v6 0x00110012001300140055005600570058
expect v7 0x00210022004300440065006600870088
end

case vrcp_table_values
asm
  vrcp v4[0],v1[0]
  vrcp v5[0],v1[1]
  vrcp v6[0],v1[2]
endasm
set v1 0x00010002010000000000000000000000
expect v4 0xc0000000000000000000000000000000
expect v5 0xe0000000000000000000000000000000
expect v6 0xffc00000000000000000000000000000
expect DIVOUT 0x007f
expect DIVDP 0
end

case vrcp_of_three_uses_the_table
asm
